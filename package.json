{
  "name": "interviewprep",
  "type": "commonjs",
  "version": "1.0.0",
  "main": "app.js",
  "scripts": {
    "start": "node server/app.js",
    "dev": "NODE_ENV=DEVELOPMENT nodemon server/app.js",
    "prod": "NODE_ENV=PRODUCTION pm2 start server/app.js --name interviewprep",
    "build": "npm install --legacy-peer-deps && npm install --legacy-peer-deps --prefix client && npm run build --prefix client",
    "pm2-restart": "pm2 restart interviewprep",
    "pm2-stop": "pm2 stop interviewprep",
    "pm2-delete": "pm2 delete interviewprep",
    "pm2-list": "pm2 list",
    "seeder": "node server/seeders/seeder.js"
  },
  "author": "Vinay",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.3",
    "colors": "^1.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.0",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.1",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
